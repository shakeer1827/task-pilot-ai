# ===========================================
# TaskPilot AI - Environment Configuration
# ===========================================

# Backend Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication (Change in production to a long random secret)
JWT_SECRET=replace-with-a-strong-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Google Gemini API (Required for live LLM planning/replanning/reporting)
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Set to "heuristic" only if you want to evaluate the app locally
# without a Gemini API key (clearly labeled in UI & logs; never fakes Gemini).
AI_FALLBACK_MODE=off

# Supabase PostgreSQL (Required for Supabase database mode)
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local SQLite fallback path when Supabase credentials are not configured
LOCAL_DB_PATH=./data/taskpilot.db
